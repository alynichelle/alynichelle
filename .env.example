# Copy to .env (local only). Do NOT commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx   # your Supabase "Publishable" (anon) key
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}

# Optional: base URL for your deployed API (Vercel)
EXPO_PUBLIC_API_BASE_URL=https://your-vercel-app.vercel.app

# Server-only (never ship to the client)
STRIPE_SECRET_KEY=sk_test_xxx
SUPABASE_SERVICE_ROLE_KEY=service_role_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
